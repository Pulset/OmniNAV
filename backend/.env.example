# OmniNAV 后端环境配置（复制为 .env 后填写）

# PostgreSQL（本机 brew 服务）
DATABASE_URL=postgresql+asyncpg://omninav_admin:omninav@localhost:5432/omninav

# Redis（盘中行情缓存 / 告警去重锁）
REDIS_URL=redis://localhost:6379/0

# 通知通道（至少配置一个）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/d3a576f2-7ca4-4d17-bc05-313984dadb69
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 调度开关（本地调试可设 false）
ENABLE_SCHEDULER=true

# 首管理员（sys_users 为空时由迁移 0003 创建；INIT_ADMIN_PASSWORD 未设置则迁移报错）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=
