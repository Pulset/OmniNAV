# OmniNAV Docker 部署环境变量（复制为同目录 .env 后填写；docker compose 自动读取）
# 真实密码只填 .env，本模板保持占位符（本文件会提交到 git）

# NAS 上已有的 PostgreSQL 连接串（必填）。
# host.docker.internal 指向宿主机（NAS 本机）；示例端口 5433 = NAS 上 PG 容器（postgres:17）的宿主机映射端口
# 前置条件：PG 里需已建好角色与库：
#   CREATE ROLE omninav_admin LOGIN PASSWORD '...';
#   CREATE DATABASE omninav OWNER omninav_admin;
# 若 PG 容器限制了来源 IP，需在 pg_hba.conf 放行 Docker 网段：host all all 172.16.0.0/12 scram-sha-256
DATABASE_URL=postgresql+asyncpg://omninav_admin:你的密码@host.docker.internal:5433/omninav

# 首管理员密码（首次对空库启动时由迁移 0003 播种 admin 账号）
INIT_ADMIN_PASSWORD=

# 前置 HTTPS 后改为 true
COOKIE_SECURE=false

# NAS 常驻保持 true
ENABLE_SCHEDULER=true

# 家宽访问 Yahoo（yfinance）需要代理时填，例如 http://192.168.x.x:7890
# AkShare 抓国内源时会自动绕过代理，互不影响
HTTPS_PROXY=http://192.168.154.123:7890

# 反向代理之后改为 * 或代理的容器 IP（默认仅信任本机）
FORWARDED_ALLOW_IPS=127.0.0.1
